[Unit]
Description=Control Centre (dcmini and Predator)
After=network.target

[Service]
ExecStart=/usr/bin/python3 %h/predator-control/server.py
Restart=on-failure
RestartSec=5
# data (token + action log, no prompts) lives only in ~/.local/share/predator-control
UMask=0077
# SysBear uses existing narrowly allowlisted sudo helpers for fan/power/LLM controls.
NoNewPrivileges=false
# User-service PrivateTmp creates a user namespace that blocks the sudo helpers.
PrivateTmp=false
# keep a detached `ssh` that holds ComfyUI on Predator alive across a restart of this service
KillMode=process

[Install]
WantedBy=default.target
